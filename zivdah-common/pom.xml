<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- 🔥 REQUIRED: inherit Java 17 + Spring Boot config -->
	<parent>
		<groupId>com.zivdah</groupId>
		<artifactId>zivdah-api</artifactId>
		<version>1.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>zivdah-common</artifactId>
	<packaging>jar</packaging>

	<dependencies>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Jackson (version managed by Spring Boot) -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- Unit tests for the shared logging/security helpers (LogSanitizer, ...). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Needed for the shared service-to-service authentication filter
		     (com.zivdah.common.security). Provided, not compile: every service that registers
		     that filter already depends on spring-boot-starter-security itself. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Needed for FilePart/Mono in the shared upload service. Every consuming
		     service already depends on this directly, so it's provided here to
		     avoid pulling a second (potentially mismatched) copy into the fat jar. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Actuator for every service, behind the shared MONITOR_USERNAME/PASSWORD Basic login
		     (com.zivdah.common.monitoring). Compile, not provided — unlike the entries around it,
		     no service declared it itself, and this way none has to. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Kafka client, used by the shared log-shipping KafkaLogAppender. provided: every
		     consuming service already depends on spring-kafka directly (or will, once wired
		     for log shipping), which brings its own kafka-clients onto the runtime classpath. -->
		<dependency>
			<groupId>org.apache.kafka</groupId>
			<artifactId>kafka-clients</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Logback, used by the shared KafkaLogAppender. provided: already pulled in
		     transitively by every consuming service's spring-boot-starter. -->
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Needed for CorrelationIdWebFilter/WebFilter interface. Every consuming service
		     already depends on spring-boot-starter-webflux directly (see above). -->
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-core</artifactId>
			<scope>provided</scope>
		</dependency>

	</dependencies>
</project>


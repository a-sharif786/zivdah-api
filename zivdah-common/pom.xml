<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- 🔥 REQUIRED: inherit Java 17 + Spring Boot config -->
	<parent>
		<groupId>com.zivdah</groupId>
		<artifactId>zivdah-api</artifactId>
		<version>1.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>zivdah-common</artifactId>
	<packaging>jar</packaging>

	<dependencies>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Jackson (version managed by Spring Boot) -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- Needed for FilePart/Mono in the shared upload service. Every consuming
		     service already depends on this directly, so it's provided here to
		     avoid pulling a second (potentially mismatched) copy into the fat jar. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Cloudinary SDK, shared so any service can reuse the upload logic. provided: this
		     pulls in Apache HttpClient 4.4 (see cloudinary-http44's own name/transitive deps),
		     which collides with the httpclient version Eureka's own Jersey3 replication client
		     needs (NoSuchMethodError on HttpClientBuilder.setSSLContext) if it leaks transitively
		     into every service that merely depends on zivdah-common for logging. Only
		     zivdah-product-service actually uses CloudinaryUploadService, so it declares this
		     dependency directly itself (compile scope) instead of relying on the transitive copy. -->
		<dependency>
			<groupId>com.cloudinary</groupId>
			<artifactId>cloudinary-http44</artifactId>
			<version>1.38.0</version>
			<scope>provided</scope>
		</dependency>

		<!-- Kafka client, used by the shared log-shipping KafkaLogAppender. provided: every
		     consuming service already depends on spring-kafka directly (or will, once wired
		     for log shipping), which brings its own kafka-clients onto the runtime classpath. -->
		<dependency>
			<groupId>org.apache.kafka</groupId>
			<artifactId>kafka-clients</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Logback, used by the shared KafkaLogAppender. provided: already pulled in
		     transitively by every consuming service's spring-boot-starter. -->
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Needed for CorrelationIdWebFilter/WebFilter interface. Every consuming service
		     already depends on spring-boot-starter-webflux directly (see above). -->
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-core</artifactId>
			<scope>provided</scope>
		</dependency>

	</dependencies>
</project>


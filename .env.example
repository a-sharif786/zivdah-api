# Copy this file to .env and fill in real values before deploying with
# docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# .env itself is gitignored — never commit real production credentials.

# --- Postgres (production database) ---
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=zivdah_db
DB_USERNAME=postgres
DB_PASSWORD=root

# --- Kafka / Eureka / Redis (defaults match the docker-compose service names, only
# change these if you point prod at infra outside this compose network) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
EUREKA_URL=http://eureka-server:8761/eureka
REDIS_HOST=redis
REDIS_PORT=6379

# --- Secrets: replace before deploying, do not reuse the dev values ---
JWT_SECRET=CHANGE_ME_use_a_securely_generated_32plus_character_secret
MAIL_USERNAME=CHANGE_ME@example.com
MAIL_PASSWORD=CHANGE_ME_gmail_app_password

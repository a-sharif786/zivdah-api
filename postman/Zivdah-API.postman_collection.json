    {
      "name": "Order Service",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"subTotal\": 400.00,\n  \"gstAmount\": 20.00,\n  \"cgstAmount\": 10.00,\n  \"sgstAmount\": 10.00,\n  \"igstAmount\": 0.00,\n  \"totalTaxAmount\": 20.00,\n  \"deliveryCharge\": 30.00,\n  \"packagingCharge\": 5.00,\n  \"handlingCharge\": 5.00,\n  \"discountAmount\": 0.00,\n  \"couponCode\": \"{{couponCode}}\",\n  \"totalAmount\": 460.00,\n  \"currency\": \"INR\",\n  \"deliveryAddressLine1\": \"123 MG Road\",\n  \"deliveryAddressLine2\": \"Near City Mall\",\n  \"deliveryCity\": \"Bengaluru\",\n  \"deliveryState\": \"Karnataka\",\n  \"deliveryPinCode\": \"560001\",\n  \"deliveryCountry\": \"India\",\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"vendorId\": {{vendorId}},\n      \"quantity\": 2,\n      \"price\": 40.00,\n      \"subtotal\": 80.00\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/restful/v1/api/orders/create",
            "description": "Permitted by the security matcher without auth (single-segment wildcard) and has no @PreAuthorize — effectively public in the current backend config. `items[].vendorId` is client-supplied (e.g. copied from the product's vendorId at checkout) and denormalized onto the order line item, enabling vendor-scoped order lookups later."
          }
        },
        {
          "name": "Get Order By Id",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restful/v1/api/orders/{{orderId}}",
            "description": "Permitted by the security matcher without auth (single-segment wildcard) — effectively public in the current backend config."
          }
        },
        {
          "name": "Get Orders By User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restful/v1/api/orders/user/{{userId}}",
            "description": "Requires auth (any authenticated user, no specific role check)."
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/restful/v1/api/orders/cancel/{{orderId}}",
            "description": "Requires auth (any authenticated user, no specific role check)."
          }
        },
        {
          "name": "Get All Orders (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restful/v1/api/orders/all?page=0&size=10",
            "description": "Requires ROLE_ADMIN. Optional query param `status` (e.g. CREATED, CONFIRMED, CANCELLED) filters by OrderStatus."
          }
        },
        {
          "name": "Get Orders By Vendor",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restful/v1/api/orders/vendor/{{vendorId}}?page=0&size=10",
            "description": "Requires ROLE_ADMIN or ROLE_VENDOR. A VENDOR caller may only query their own id — 403 otherwise. Returns orders containing at least one line item from that vendor, with the `items` array filtered to only that vendor's lines. Pagination is over order-item rows, so a page may contain fewer than `size` distinct orders."
          }
        }
      ]
    },
    {
      "name": "Payment Service",
      "item": [
        {
          "name": "Initiate Payment",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"userId\": {{userId}},\n  \"amount\": 460.00,\n  \"currency\": \"INR\",\n  \"method\": \"UPI\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/restful/v1/api/payments/initiate",
            "description": "Permitted by the security matcher without auth (single-segment wildcard) — effectively public in the current backend config. method enum: CARD, UPI, NET_BANKING, WALLET, APPLE_PAY, GOOGLE_PAY, BANK_TRANSFER, COD."
          }
        },
        {
          "name": "Get Payment By Id",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restful/v1/api/payments/{{paymentId}}",
            "description": "Permitted by the security matcher without auth (single-segment wildcard) — effectively public in the current backend config."
          }
        },
        {
          "name": "Get Payments By Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restful/v1/api/payments/order/{{orderId}}",
            "description": "Requires auth — this path has two segments after /payments/ so it falls outside the permitAll wildcard."
          }
        },
        {
          "name": "Mark Payment Success",

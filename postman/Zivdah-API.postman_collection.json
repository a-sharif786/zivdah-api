{
  "info": {
    "_postman_id": "b3f2a1c0-5e4d-4a6a-9c1e-zivdah00001",
    "name": "Zivdah API",
    "description": "Full API surface for the Zivdah online grocery microservices platform, routed through the API Gateway (localhost:8001). Covers auth, product, cart, order, payment, notification, inventory, user, review, and coupon services.\n\nAuth model: most endpoints require `Authorization: Bearer {{token}}` (set at collection level). Requests that are genuinely public are marked No Auth at the request level. Obtain a token via Auth > Login or Auth > Verify OTP and set it into the `token` collection variable.\n\nNote: every service's JWT filter now correctly extracts userId+role from the token into Spring Security authorities (fixed across cart/order/payment/notification/inventory/review/coupon services to match auth/product/user), so @PreAuthorize role checks are enforced as documented below — a 403 reflects an actual role mismatch, not a backend authority bug.\n\nMulti-vendor support: Product now carries a server-assigned `vendorId` (null = platform/ADMIN-owned, set = created by that VENDOR user). Order line items carry a client-supplied `vendorId` snapshot at checkout, enabling vendor-scoped order visibility.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8001", "description": "API Gateway base URL. Direct service ports (bypass gateway): auth=8002, product=8003, cart=8004, order=8005, payment=8006, notification=8007, inventory=8008, user=8009, review=8010, coupon=8011" },
    { "key": "token", "value": "", "description": "JWT from login/verify-otp response data.token" },
    { "key": "userId", "value": "1" },
    { "key": "vendorId", "value": "1", "description": "A VENDOR-role user's id, used by vendor-scoped endpoints" },
    { "key": "productId", "value": "1" },
    { "key": "category", "value": "GROCERY", "description": "One of VEGETABLE, FRUIT, MILK, PULSE, GROCERY" },
    { "key": "bannerId", "value": "1" },
    { "key": "cartItemId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "paymentId", "value": "1" },
    { "key": "reviewId", "value": "1" },
    { "key": "couponCode", "value": "SAVE10" },
    { "key": "couponId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"mobile\": \"9876543210\",\n  \"role\": \"USER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/restful/v1/api/auth/register",
            "description": "Public. role is optional enum: USER, ADMIN, VENDOR."
          }
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/restful/v1/api/auth/login",
            "description": "Public. Provide mobile or email plus password. Response data.token can be copied into the token collection variable."
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/restful/v1/api/auth/send-otp",
            "description": "Public. OTP is currently a static demo placeholder (123456) until a real SMS/email provider is wired up."
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\",\n  \"otp\": \"123456\",\n  \"deviceToken\": \"sample-device-token\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/restful/v1/api/auth/verify-otp",
            "description": "Public. Returns LoginResponseDTO including token."
          }
        },
        {
          "name": "Get User By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restful/v1/api/auth/byUserId/{{userId}}",
            "description": "Requires auth. Caller must be the owner (JWT userId matches) or ROLE_ADMIN."
          }
        },
        {
          "name": "Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/restful/v1/api/auth/all-users",
            "description": "Security matcher permits this path publicly, but @PreAuthorize(hasRole('ADMIN')) is enforced at the method level — a valid ADMIN bearer token is required regardless."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/restful/v1/api/auth/update-profile/{{userId}}",
            "description": "Requires auth. Owner or ROLE_ADMIN."
          }
        },
        {
          "name": "Forget Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/restful/v1/api/auth/forget-password",
            "description": "Public. Triggers OTP to email for password reset."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"newPassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/restful/v1/api/auth/reset-password",
            "description": "Public."
          }
        },
        {
          "name": "Verify Registration OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\",\n  \"email\": \"john.doe@example.com\",\n  \"mobileOtp\": \"123456\",\n  \"emailOtp\": \"123456\",\n  \"deviceToken\": \"sample-device-token\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/restful/v1/api/auth/verify-registration-otp",
            "description": "Public. Returns LoginResponseDTO including token."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/restful/v1/api/auth/logout",
            "description": "Requires auth."
          }
        },
        {
          "name": "Update Role (Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"VENDOR\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/restful/v1/api/auth/update-role/{{userId}}",
            "description": "Requires ROLE_ADMIN. role enum: USER, ADMIN, VENDOR."
          }
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/restful/v1/api/auth/deactivate/{{userId}}",
            "description": "Security matcher permits this publicly, but controller code checks owner-or-admin against the auth context, so a valid bearer token is effectively required."
          }
        },
        {
          "name": "Activate User (Admin)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/restful/v1/api/auth/activate/{{userId}}",
            "description": "@PreAuthorize(hasRole('ADMIN')) — requires a valid ADMIN bearer token despite the permitAll security matcher."
          }
        }
      ]
    },
    {
